<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Mirrorgen.Core\Mirrorgen.Core.csproj" />
        <ProjectReference Include="..\..\src\Mirrorgen.Attributes\Mirrorgen.Attributes.csproj" />
        <ProjectReference Include="..\..\src\Mirrorgen.Analyzers\Mirrorgen.Analyzers.csproj"
                          ReferenceOutputAssembly="true"
                          OutputItemType="" />
    </ItemGroup>

    <ItemGroup>
        <!-- TsGenParity fixture: source .cs + TsGen-emitted golden .ts copied
             to the test output dir so TsGenParityTests can read them at runtime. -->
        <None Include="Fixtures\**\*.*" CopyToOutputDirectory="PreserveNewest" />
        <!-- Exclude fixture .cs from the test project's own compile -->
        <Compile Remove="Fixtures\**\*.cs" />
    </ItemGroup>

</Project>
