<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <RootNamespace>Mirrorgen.Samples.Minimal</RootNamespace>
        <AssemblyName>Mirrorgen.Samples.Minimal.Rules</AssemblyName>

        <!-- Where the MSBuild target writes the emitted .ts files. -->
        <MirrorgenOutput>$(MSBuildThisFileDirectory)..\client\src\_generated\</MirrorgenOutput>
        <MirrorgenSourceRoot>$(MSBuildThisFileDirectory)</MirrorgenSourceRoot>
        <!-- Also capture C# expected outputs from [GenerateCrossTest] members. -->
        <MirrorgenEmitFixtures>true</MirrorgenEmitFixtures>
        <MirrorgenFixturesOutput>$(MirrorgenOutput)Pricing.fixtures.json</MirrorgenFixturesOutput>
        <!-- IMirrorgenExtension implementation that maps OrderId -> number. -->
        <MirrorgenConfig>Mirrorgen.Samples.Minimal.MirrorgenConfig</MirrorgenConfig>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\Mirrorgen.Attributes\Mirrorgen.Attributes.csproj" />
        <ProjectReference Include="..\..\..\src\Mirrorgen.MSBuild\Mirrorgen.MSBuild.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="" />
    </ItemGroup>

    <!--
      In a published-package world, adding `Mirrorgen.MSBuild` as a
      PackageReference is enough — the NuGet build/ folder injects the
      targets automatically. From this dev tree we instead point at the
      built assembly directly and import the .targets file by path.
    -->
    <PropertyGroup>
        <MirrorgenTasksAssembly>$(MSBuildThisFileDirectory)..\..\..\src\Mirrorgen.MSBuild\bin\$(Configuration)\net8.0\Mirrorgen.MSBuild.dll</MirrorgenTasksAssembly>
    </PropertyGroup>
    <Import Project="..\..\..\src\Mirrorgen.MSBuild\build\Mirrorgen.MSBuild.targets" />

    <!--
      Subset enforcement at compile time. The analyzer targets the oldest
      supported Roslyn precisely so csc can load it — see the version
      override in Mirrorgen.Analyzers.csproj.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\src\Mirrorgen.Analyzers\Mirrorgen.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
