<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <PackageId>Mirrorgen.Analyzers</PackageId>
        <Description>Roslyn analyzer that enforces the Mirrorgen C# subset on [Transpile] members. Violations are reported as build errors with stable diagnostic ids.</Description>
        <PackageTags>csharp;analyzer;roslyn;mirrorgen</PackageTags>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <!--
          The analyzer .dll is packed into analyzers/dotnet/cs/ rather than lib/,
          so the default snupkg layout (which expects symbols beside lib/) ends up
          empty and is rejected by nuget.org. Skip symbol packaging here — embed
          the PDB inside the .nupkg via DebugType=embedded instead.
        -->
        <IncludeSymbols>false</IncludeSymbols>
        <DebugType>embedded</DebugType>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzerToPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mirrorgen.Attributes\Mirrorgen.Attributes.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
          Analyzers must target the *oldest* Roslyn they support, not the
          newest: csc refuses to load an analyzer that references a compiler
          version newer than its own (CS9057), and the failure is a warning, so
          the analyzer silently stops running. The repo-wide pin is ahead of
          every released SDK, hence the override here. Mirrorgen.Core is not
          loaded by csc and keeps the central version.
          4.14.0 covers .NET SDK 9 and later.
        -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" VersionOverride="4.14.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" Condition="Exists('AnalyzerReleases.Shipped.md')" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>

    <Target Name="_AddAnalyzerToPackage">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(OutputPath)\$(AssemblyName).dll" PackagePath="analyzers/dotnet/cs/" />
        </ItemGroup>
    </Target>

</Project>
